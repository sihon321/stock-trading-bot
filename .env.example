TRADING_MODE=mock
CONFIRM_REAL_TRADING=no
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# ANTHROPIC_AUTH_TOKEN is an ALTERNATIVE to ANTHROPIC_API_KEY for the Claude
# provider: an OAuth bearer token (e.g. from `ant auth login` / Claude Code,
# format like sk-ant-oat01-...). When both are set, the auth token takes
# precedence. Leave blank if you use an API key. Never commit a real token.
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=replace-with-openai-api-key

KIS_MOCK__DOMAIN=https://replace-with-kis-mock-domain
KIS_MOCK__APP_KEY=replace-with-kis-mock-app-key
KIS_MOCK__APP_SECRET=replace-with-kis-mock-app-secret
KIS_MOCK__TR_ID_PROFILE=mock
KIS_MOCK__LABEL=KIS mock account

KIS_REAL__DOMAIN=https://replace-with-kis-real-domain
KIS_REAL__APP_KEY=replace-with-kis-real-app-key
KIS_REAL__APP_SECRET=replace-with-kis-real-app-secret
KIS_REAL__TR_ID_PROFILE=real
KIS_REAL__LABEL=KIS real account

DRY_RUN=true
